                  "const folderId = pm.environment.get('folder_id');",
                  "",
                  "if (!folderId || folderId.includes('PASTE_')) {",
                  "    throw new Error('Set folder_id in the selected Postman environment');",
                  "}",
                  "",
                  "const tempListName = `Pre Post List ${Date.now()}`;",
                  "",
                  "pm.sendRequest({",
                  "    url: `https://api.clickup.com/api/v2/folder/${folderId}/list`,",
                  "    method: 'POST',",
                  "    header: {",
                  "        Authorization: token,",
                  "        'Content-Type': 'application/json',",
                  "        accept: 'application/json'",
                  "    },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            name: tempListName,",
                  "            content: 'Created by pre-request script'",
                  "        })",
                  "    }",
                  "}, function (err, createResponse) {",
                  "    if (err) {",
                  "        throw new Error(`Pre-request create failed: ${err}`);",
                  "    }",
                  "",
                  "    pm.test('Pre-request created list', function () {",
                  "        pm.expect(createResponse.code).to.be.oneOf([200, 201]);",
                  "    });",
                  "",
                  "    const createdList = createResponse.json();",
                  "",
                  "    pm.environment.set('temp_list_id', createdList.id);",
                  "    pm.environment.set('temp_list_name', createdList.name);",
                  "",
                  "    console.log('Created in pre-request:', createdList.id);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['id', 'name'],",
                  "    properties: {",
                  "        id: { type: 'string' },",
                  "        name: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('Schema is valid', function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
