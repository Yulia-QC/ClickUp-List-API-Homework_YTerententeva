                  "pm.test('Main request returned created list', function () {",
                  "    pm.expect(String(json.id)).to.eql(String(pm.environment.get('temp_list_id')));",
                  "});",
                  "",
                  "const token = pm.environment.get('clickup_token');",
                  "const listId = pm.environment.get('temp_list_id');",
                  "",
                  "pm.sendRequest({",
                  "    url: `https://api.clickup.com/api/v2/list/${listId}`,",
                  "    method: 'DELETE',",
                  "    header: {",
                  "        Authorization: token,",
                  "        accept: 'application/json'",
                  "    }",
                  "}, function (err, deleteResponse) {",
