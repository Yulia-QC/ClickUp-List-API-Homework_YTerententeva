        {
          "name": "05 Get List with pre-request create and post-response delete",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const token = pm.environment.get('clickup_token');",
                  "",
                  "if (!token || token.includes('PASTE_')) {",
