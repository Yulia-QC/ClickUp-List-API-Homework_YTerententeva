    {
      "name": "01 Positive lifecycle - create, verify, update, delete",
      "item": [
        {
          "name": "01 Create List",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('clickup_token');",
                  "if (!token || token.includes('PASTE_')) { throw new Error('Set clickup_token in the selected Postman environment'); }",
                  "const folderId = pm.environment.get('folder_id');",
                  "if (!folderId || folderId.includes('PASTE_')) { throw new Error('Set folder_id in the selected Postman environment'); }",
                  "const unique = Date.now();",
                  "pm.environment.set('list_name', `Postman Homework List ${unique}`);",
                  "pm.environment.set('updated_list_name', `Postman Homework List Updated ${unique}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response has id and name', () => { pm.expect(json.id).to.exist; pm.expect(json.name).to.eql(pm.environment.get('list_name')); });",
                  "pm.environment.set('list_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{clickup_token}}",
                "type": "text"
              },
              {
                "key": "accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{list_name}}\",\n  \"content\": \"Created by Postman homework collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://api.clickup.com/api/v2/folder/{{folder_id}}/list",
              "protocol": "https",
              "host": [
                "api",
                "clickup",
                "com"
              ],
              "path": [
                "api",
                "v2",
                "folder",
                "{{folder_id}}",
                "list"
              ]
            }
          },
          "response": []
        },
