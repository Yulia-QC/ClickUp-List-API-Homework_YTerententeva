          "name": "02 Get Lists and verify created list exists",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('clickup_token');",
                  "if (!token || token.includes('PASTE_')) { throw new Error('Set clickup_token in the selected Postman environment'); }",
                  "const folderId = pm.environment.get('folder_id');",
                  "if (!folderId || folderId.includes('PASTE_')) { throw new Error('Set folder_id in the selected Postman environment'); }",
                  "if (!pm.environment.get('list_id')) { throw new Error('Run 01 Create List first'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const listId = pm.environment.get('list_id');",
                  "pm.test('Response contains lists array', () => pm.expect(json.lists).to.be.an('array'));",
                  "pm.test('Created list exists in folder lists', () => pm.expect(json.lists.map(l => String(l.id))).to.include(String(listId)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{clickup_token}}",
                "type": "text"
              },
              {
                "key": "accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://api.clickup.com/api/v2/folder/{{folder_id}}/list?archived=false",
              "protocol": "https",
              "host": [
                "api",
                "clickup",
                "com"
              ],
              "path": [
                "api",
                "v2",
                "folder",
                "{{folder_id}}",
                "list"
              ],
              "query": [
                {
                  "key": "archived",
                  "value": "false"
                }
              ]
            }
          },
          "response": []
